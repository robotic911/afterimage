{
  "name": "kuku-photobooth-app",
  "productName": "Afterimage",
  "author": "Kenneth G. Patiño",
  "description": "Afterimage photobooth kiosk — capture, print, and track sessions.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "electron": "electron .",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "data:export": "node scripts/portable-data.cjs export",
    "data:import": "node scripts/portable-data.cjs import",
    "data:validate": "node scripts/portable-data.cjs validate",
    "pack": "vite build && electron-builder --dir",
    "pack:win": "vite build && electron-builder --win --x64 --dir",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.3",
    "gifshot": "^0.4.5",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^9.39.4",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "electron": "^41.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.9",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.kennethpatino.kukuphotobooth",
    "productName": "Afterimage",
    "copyright": "Copyright © 2026 Kenneth G. Patiño",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron.cjs",
      "keychainPricing.config.json",
      "keychainPricing.cjs",
      "preload.cjs",
      "scripts/portable-data.cjs",
      "dist/**/*",
      "default-templates/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": "dmg",
      "category": "public.app-category.photography",
      "icon": "build/icon.png"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Afterimage-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Afterimage",
      "uninstallDisplayName": "Afterimage ${version}",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics"
    }
  }
}
